# ─────────────────────────────────────────────────────────────────────────────
# Smart Barangay — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# (`.env` is gitignored; if it was ever committed, rotate every secret below.)
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
# Public base URL of this backend (used for absolute links / redirects)
PUBLIC_URL=http://localhost:8000
# Set automatically by Render in production; leave blank locally
RENDER_EXTERNAL_URL=

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
# JWT signing secret (SUPABASE_JWT_SECRET is primary; JWT_SECRET is the fallback)
SUPABASE_JWT_SECRET=your-jwt-signing-secret
JWT_SECRET=your-jwt-signing-secret
# Optional: path to a custom DB SSL cert (leave blank to use defaults)
DB_SSL_CERT_PATH=

# ── Cloudinary (incident evidence + announcement images) ─────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── Email: Resend (primary) ──────────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=no-reply@your-domain.example

# ── Email: SMTP fallback ─────────────────────────────────────────────────────
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@your-domain.example

# ── Admin / security ─────────────────────────────────────────────────────────
# Email that receives the emergency Root (Ghost Admin) security codes
ROOT_EMAIL=admin@your-domain.example
# Extra gate key for privileged admin actions
ADMIN_GATE_KEY=change-me

# ── Frontend (Vite — exposed to the browser, do NOT put secrets here) ─────────
VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_BASE_URL_CLOUD=https://your-backend.onrender.com/api
